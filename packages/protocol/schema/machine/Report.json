{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "load": {
      "additionalProperties": false,
      "properties": {
        "inFlight": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "loadAvg1": {
          "minimum": 0,
          "type": "number"
        },
        "memoryAvailableBytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "loadAvg1",
        "memoryAvailableBytes",
        "inFlight"
      ],
      "type": "object"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "reportedAt": {
      "minimum": 0,
      "type": "number"
    },
    "screen": {
      "additionalProperties": false,
      "properties": {
        "permission": {
          "enum": [
            "granted",
            "denied",
            "unsupported"
          ],
          "type": "string"
        }
      },
      "required": [
        "permission"
      ],
      "type": "object"
    },
    "streams": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytesPerSecond": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "droppedFrames": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "encodeMs": {
            "maximum": 60000,
            "minimum": 0,
            "type": "number"
          },
          "fps": {
            "maximum": 60,
            "minimum": 0,
            "type": "number"
          },
          "retainedBytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "streamId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "streamId",
          "fps",
          "bytesPerSecond",
          "encodeMs",
          "droppedFrames",
          "retainedBytes"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "type": "array"
    }
  },
  "required": [
    "machineId",
    "reportedAt",
    "load",
    "screen"
  ],
  "type": "object"
}
