{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "additionalProperties": false,
          "properties": {
            "byteOffset": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "generation": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "recordHash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "sessionId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "sessionId",
            "generation",
            "byteOffset",
            "recordHash"
          ],
          "type": "object"
        },
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status",
        "cursor"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "machine_not_attached",
            "session_not_available",
            "session_not_found",
            "invalid_cursor",
            "permission_denied",
            "permission_timeout"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
