{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "cellId": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "session",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "machine",
              "type": "string"
            },
            "machineId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "machineId"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "cellId",
    "name",
    "arguments"
  ],
  "type": "object"
}
