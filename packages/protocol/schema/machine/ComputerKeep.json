{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "enum": [
        "deliverable",
        "handoff"
      ],
      "type": "string"
    },
    "target": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "additionalProperties": false,
          "properties": {
            "epoch": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "pid": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "windowId": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "pid",
            "windowId",
            "epoch"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "machineId",
    "target",
    "reason"
  ],
  "type": "object"
}
