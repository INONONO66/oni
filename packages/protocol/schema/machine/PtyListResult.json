{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "type": "string"
              },
              "status": {
                "enum": [
                  "live",
                  "lost"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "status"
            ],
            "type": "object"
          },
          "maxItems": 1000,
          "type": "array"
        },
        "status": {
          "const": "ok",
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "sessions",
        "truncated"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "machine_not_attached",
            "pty_not_available"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
