{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "changeCount": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "previous": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "changeCount": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "formats": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "changeCount",
            "formats",
            "bytes"
          ],
          "type": "object"
        },
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status",
        "changeCount",
        "previous"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "machine_not_attached",
            "permission_denied",
            "clipboard_not_available",
            "clipboard_too_large"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
