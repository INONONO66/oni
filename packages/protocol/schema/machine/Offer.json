{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "daemonVersion": {
      "minLength": 1,
      "type": "string"
    },
    "exports": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "offeredAt": {
      "minimum": 0,
      "type": "number"
    },
    "offeredCapabilities": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "type": "string"
      },
      "type": "array"
    },
    "peer": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "daemon",
            "client"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "contractVersion"
      ],
      "type": "object"
    },
    "platform": {
      "minLength": 1,
      "type": "string"
    },
    "resources": {
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "memoryBytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "cpus",
        "memoryBytes"
      ],
      "type": "object"
    }
  },
  "required": [
    "machineId",
    "offeredCapabilities",
    "daemonVersion",
    "platform",
    "offeredAt",
    "peer"
  ],
  "type": "object"
}
