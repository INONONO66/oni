{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "additionalProperties": false,
          "properties": {
            "byteOffset": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "generation": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "recordHash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "sessionId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "sessionId",
            "generation",
            "byteOffset",
            "recordHash"
          ],
          "type": "object"
        },
        "hasMore": {
          "type": "boolean"
        },
        "records": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "turn",
                    "type": "string"
                  },
                  "role": {
                    "enum": [
                      "user",
                      "assistant"
                    ],
                    "type": "string"
                  },
                  "text": {
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "role",
                  "text"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "callId": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "input": {
                    "maxLength": 4096,
                    "type": "string"
                  },
                  "kind": {
                    "const": "tool_call",
                    "type": "string"
                  },
                  "name": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "callId",
                  "name",
                  "input"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "callId": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "failed": {
                    "type": "boolean"
                  },
                  "kind": {
                    "const": "tool_result",
                    "type": "string"
                  },
                  "output": {
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "callId",
                  "output",
                  "failed"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "excerpt": {
                    "maxLength": 4096,
                    "type": "string"
                  },
                  "kind": {
                    "const": "corrupt",
                    "type": "string"
                  },
                  "reason": {
                    "enum": [
                      "invalid_encoding",
                      "invalid_shape",
                      "unsupported_record"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "reason",
                  "excerpt"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "truncated",
                    "type": "string"
                  },
                  "originalBytes": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "prefix": {
                    "maxLength": 4096,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "originalBytes",
                  "prefix"
                ],
                "type": "object"
              }
            ]
          },
          "maxItems": 32,
          "type": "array"
        },
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status",
        "records",
        "cursor",
        "hasMore"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "machine_not_attached",
            "session_not_available",
            "session_not_found",
            "invalid_cursor",
            "permission_denied",
            "permission_timeout"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
