{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "data": {
      "maxLength": 21848,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "name": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    }
  },
  "required": [
    "name",
    "data"
  ],
  "type": "object"
}
