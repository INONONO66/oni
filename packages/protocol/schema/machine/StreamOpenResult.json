{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "expiresAt": {
          "minimum": 0,
          "type": "number"
        },
        "status": {
          "const": "opened",
          "type": "string"
        },
        "streamId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "status",
        "streamId",
        "expiresAt"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "machine_not_attached",
            "stream_not_available",
            "display_not_found",
            "window_not_found",
            "permission_denied",
            "stream_limit",
            "already_open",
            "encoder_failed"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
