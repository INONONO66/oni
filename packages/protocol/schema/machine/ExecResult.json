{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "exitCode": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "const": "completed",
          "type": "string"
        },
        "stderr": {
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "stdout": {
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "stdout",
        "stderr",
        "exitCode",
        "signal",
        "truncated"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "machine_not_attached",
            "exec_not_available",
            "path_escapes_export",
            "io_error"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "timed_out",
            "cancelled"
          ],
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  ]
}
