{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "cli": {
      "enum": [
        "claude-code",
        "codex",
        "pi",
        "omp"
      ],
      "type": "string"
    },
    "project": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^\\/(?!\\.\\.(?:\\/|$)|.*\\/\\.\\.(?:\\/|$))[^\\x00]*$",
      "type": "string"
    },
    "sessionId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "enum": [
        "running",
        "stopped"
      ],
      "type": "string"
    }
  },
  "required": [
    "sessionId",
    "project",
    "cli",
    "state"
  ],
  "type": "object"
}
