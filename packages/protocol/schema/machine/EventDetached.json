{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "enum": [
        "connection_closed",
        "host_closed",
        "enrollment_removed",
        "enrollment_replaced",
        "superseded_by_reattach",
        "superseded",
        "ping_timeout"
      ],
      "type": "string"
    },
    "time": {
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "machineId",
    "time",
    "reason"
  ],
  "type": "object"
}
