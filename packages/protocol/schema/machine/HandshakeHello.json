{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "ephemeralKey": {
      "pattern": "^[A-Za-z0-9+/]{43}=$",
      "type": "string"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "nonce": {
      "pattern": "^[A-Za-z0-9+/]{43}=$",
      "type": "string"
    },
    "peer": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "daemon",
            "client"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "contractVersion"
      ],
      "type": "object"
    },
    "signature": {
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "type": "string"
    },
    "staticKey": {
      "maxLength": 1024,
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    }
  },
  "required": [
    "machineId",
    "peer",
    "staticKey",
    "ephemeralKey",
    "nonce",
    "signature"
  ],
  "type": "object"
}
