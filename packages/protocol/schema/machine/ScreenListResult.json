{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "displays": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "display": {
                "exclusiveMinimum": 0,
                "maximum": 16,
                "type": "integer"
              },
              "height": {
                "exclusiveMinimum": 0,
                "maximum": 16384,
                "type": "integer"
              },
              "primary": {
                "type": "boolean"
              },
              "scale": {
                "exclusiveMinimum": 0,
                "maximum": 8,
                "type": "number"
              },
              "width": {
                "exclusiveMinimum": 0,
                "maximum": 16384,
                "type": "integer"
              }
            },
            "required": [
              "display",
              "width",
              "height",
              "scale",
              "primary"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "observedAt": {
          "minimum": 0,
          "type": "number"
        },
        "status": {
          "const": "ok",
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "windows": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "app": {
                "additionalProperties": false,
                "properties": {
                  "bundleId": {
                    "anyOf": [
                      {
                        "maxLength": 256,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "path": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "bundleId",
                  "path"
                ],
                "type": "object"
              },
              "bounds": {
                "additionalProperties": false,
                "properties": {
                  "height": {
                    "maximum": 16384,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "width": {
                    "maximum": 16384,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "x": {
                    "maximum": 16384,
                    "minimum": -16384,
                    "type": "integer"
                  },
                  "y": {
                    "maximum": 16384,
                    "minimum": -16384,
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "type": "object"
              },
              "display": {
                "exclusiveMinimum": 0,
                "maximum": 16,
                "type": "integer"
              },
              "kind": {
                "default": "window",
                "enum": [
                  "window",
                  "menu",
                  "sheet",
                  "popover",
                  "alert"
                ],
                "type": "string"
              },
              "owner": {
                "maxLength": 256,
                "type": "string"
              },
              "parent": {
                "additionalProperties": false,
                "properties": {
                  "epoch": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "pid": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "windowId": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "pid",
                  "windowId"
                ],
                "type": "object"
              },
              "pid": {
                "maximum": 9007199254740991,
                "minimum": 1,
                "type": "integer"
              },
              "title": {
                "maxLength": 256,
                "type": "string"
              },
              "windowId": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "windowId",
              "kind",
              "display",
              "title",
              "owner",
              "bounds"
            ],
            "type": "object"
          },
          "maxItems": 512,
          "type": "array"
        }
      },
      "required": [
        "status",
        "displays",
        "windows",
        "truncated",
        "observedAt"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "machine_not_attached",
            "screen_not_available",
            "invalid_region",
            "permission_denied",
            "capture_failed",
            "spawn_failed",
            "read_failed",
            "probe_timeout",
            "display_not_found",
            "window_not_found",
            "window_minimized",
            "capture_blank",
            "own_window",
            "superseded"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
