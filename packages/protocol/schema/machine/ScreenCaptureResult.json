{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "accessibilityTree": {},
        "accessibilityUnavailable": {
          "type": "boolean"
        },
        "captureId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "data": {
          "maxLength": 5592408,
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "display": {
          "exclusiveMinimum": 0,
          "maximum": 16,
          "type": "integer"
        },
        "downscaled": {
          "type": "boolean"
        },
        "format": {
          "enum": [
            "png",
            "jpeg"
          ],
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "type": "integer"
        },
        "observedAt": {
          "minimum": 0,
          "type": "number"
        },
        "status": {
          "const": "ok",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "captureId",
        "display",
        "format",
        "data",
        "width",
        "height",
        "downscaled",
        "observedAt"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "machine_not_attached",
            "screen_not_available",
            "invalid_region",
            "permission_denied",
            "capture_failed",
            "spawn_failed",
            "read_failed",
            "probe_timeout",
            "display_not_found",
            "window_not_found",
            "window_minimized",
            "capture_blank",
            "own_window",
            "superseded",
            "accessibility_unavailable",
            "private"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
