{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "screen_recording_denied",
              "accessibility_denied",
              "no_console_user",
              "other_console_user",
              "display_asleep",
              "no_x_display",
              "x_auth_refused",
              "x_display_forwarded",
              "wayland_only_no_x",
              "missing_x_libs",
              "no_atspi_bus",
              "observer_unavailable",
              "session_zero",
              "window_manager_missing",
              "input_monitoring_not_granted",
              "no_screen_backend",
              "input_backend_unavailable",
              "restart_bound"
            ],
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "display": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "isolated": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "console",
            "virtual",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "isolated"
      ],
      "type": "object"
    },
    "grants": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "type": "boolean"
        },
        "capture": {
          "type": "boolean"
        },
        "input": {
          "type": "boolean"
        }
      },
      "required": [
        "capture",
        "accessibility",
        "input"
      ],
      "type": "object"
    },
    "verdict": {
      "enum": [
        "available",
        "partial",
        "unavailable"
      ],
      "type": "string"
    }
  },
  "required": [
    "verdict",
    "blockers",
    "display",
    "grants"
  ],
  "type": "object"
}
