{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "inFlight": {
      "minimum": 0,
      "type": "number"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "memReserveBytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "memoryAvailableBytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "reason": {
      "enum": [
        "slots",
        "memory"
      ],
      "type": "string"
    },
    "slots": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "machineId",
    "reason",
    "slots",
    "inFlight"
  ],
  "type": "object"
}
