{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "completed",
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "error": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "const": "failed",
          "type": "string"
        }
      },
      "required": [
        "status",
        "error"
      ],
      "type": "object"
    }
  ]
}
