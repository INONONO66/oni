{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "output": {
          "additionalProperties": false,
          "properties": {
            "stderr": {
              "type": "string"
            },
            "stdout": {
              "type": "string"
            },
            "truncated": {
              "additionalProperties": false,
              "properties": {
                "stderr": {
                  "additionalProperties": false,
                  "properties": {
                    "originalBytes": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "originalBytes"
                  ],
                  "type": "object"
                },
                "stdout": {
                  "additionalProperties": false,
                  "properties": {
                    "originalBytes": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "originalBytes"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "required": [
            "stdout",
            "stderr"
          ],
          "type": "object"
        },
        "running": {
          "type": "boolean"
        }
      },
      "required": [
        "running",
        "output"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "const": "kernel_not_available",
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
