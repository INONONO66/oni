{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "channelId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "enum": [
        "requested",
        "expired",
        "endpoint_closed",
        "failed"
      ],
      "type": "string"
    }
  },
  "required": [
    "channelId",
    "reason"
  ],
  "type": "object"
}
