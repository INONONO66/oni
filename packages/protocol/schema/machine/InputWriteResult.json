{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "dispatched": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ]
        },
        "hint": {
          "const": "re_observe",
          "type": "string"
        },
        "reason": {
          "enum": [
            "transport_lost",
            "cancelled",
            "detached",
            "driver_timeout"
          ],
          "type": "string"
        },
        "status": {
          "const": "unverifiable",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "dispatched",
        "hint"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "machine_not_attached",
            "input_not_available",
            "stale_capture",
            "invalid_region",
            "permission_denied",
            "unsupported_action",
            "input_failed",
            "spawn_failed",
            "probe_timeout",
            "epoch_changed",
            "stale_observation",
            "ref_not_found",
            "action_not_supported",
            "window_not_found",
            "observe_not_available",
            "foreground_required",
            "window_busy",
            "request_busy"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
