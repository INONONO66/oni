      "maxLength": 4096,
      "type": "string"
    },
    "requestId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "sessionId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "tool": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
