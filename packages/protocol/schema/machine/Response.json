{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "rows": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "allowedCapabilities": {
                "items": {
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "allowedExports": {
                "items": {
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_-]*$",
                  "type": "string"
                },
                "type": "array"
              },
              "arch": {
                "type": "string"
              },
              "capabilities": {
                "items": {
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
                  "type": "string"
                },
                "type": "array"
              },
              "enrolledAt": {
                "minimum": 0,
                "type": "number"
              },
              "generation": {
                "maximum": 9007199254740991,
                "minimum": 1,
                "type": "integer"
              },
              "live": {
                "additionalProperties": false,
                "properties": {
                  "load": {
                    "additionalProperties": false,
                    "properties": {
                      "inFlight": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "loadAvg1": {
                        "minimum": 0,
                        "type": "number"
                      },
                      "memoryAvailableBytes": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "loadAvg1",
                      "memoryAvailableBytes",
                      "inFlight"
                    ],
                    "type": "object"
                  },
                  "reportedAt": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "screen": {
                    "additionalProperties": false,
                    "properties": {
                      "permission": {
                        "enum": [
                          "granted",
                          "denied",
                          "unsupported"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "permission"
                    ],
                    "type": "object"
                  },
                  "stale": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "reportedAt",
                  "load",
                  "stale"
                ],
                "type": "object"
              },
              "machineId": {
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "os": {
                "type": "string"
              },
              "peer": {
                "additionalProperties": false,
                "properties": {
                  "contractVersion": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "kind": {
                    "enum": [
                      "daemon",
                      "client"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "contractVersion"
                ],
                "type": "object"
              },
              "pendingCapabilities": {
                "items": {
                  "maxLength": 128,
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
                  "type": "string"
                },
                "type": "array"
              },
              "publicKey": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "resources": {
                "additionalProperties": false,
                "properties": {
                  "cpus": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  },
                  "memoryBytes": {
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "type": "integer"
                  }
                },
                "required": [
                  "cpus",
                  "memoryBytes"
                ],
                "type": "object"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "machineId",
              "name",
              "tags",
              "allowedCapabilities",
              "publicKey",
              "enrolledAt",
              "capabilities",
              "pendingCapabilities",
              "os",
              "arch"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "type": {
          "const": "machine_listed",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "rows"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "unavailable",
            "invalid_request"
          ],
          "type": "string"
        },
        "requestId": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "machine_list_refused",
          "type": "string"
        }
      },
      "required": [
        "type",
        "requestId",
        "reason",
        "detail"
      ],
      "type": "object"
    }
  ]
}
