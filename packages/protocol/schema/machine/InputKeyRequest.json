{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "press",
        "down",
        "up"
      ],
      "type": "string"
    },
    "captureId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "delivery": {
      "default": "background",
      "enum": [
        "background",
        "foreground"
      ],
      "type": "string"
    },
    "key": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "modifiers": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "type": "boolean"
        },
        "control": {
          "type": "boolean"
        },
        "meta": {
          "type": "boolean"
        },
        "shift": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "requestId": {
      "pattern": "^[1-9]\\d*-[1-9]\\d*$",
      "type": "string"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "pid": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "windowId": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pid",
        "windowId"
      ],
      "type": "object"
    }
  },
  "required": [
    "requestId",
    "captureId",
    "delivery",
    "key",
    "action"
  ],
  "type": "object"
}
