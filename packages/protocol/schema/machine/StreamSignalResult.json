{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "accepted",
          "type": "string"
        }
      },
      "required": [
        "status",
        "seq"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "machine_not_attached",
            "stream_not_found",
            "stream_expired",
            "invalid_sequence",
            "signal_limit",
            "invalid_signal"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
