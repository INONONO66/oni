{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "humanInput": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "lastAt": {
          "minimum": 0,
          "type": "number"
        },
        "source": {
          "enum": [
            "pointer",
            "keyboard",
            "both"
          ],
          "type": "string"
        }
      },
      "required": [
        "lastAt",
        "source",
        "events"
      ],
      "type": "object"
    },
    "load": {
      "additionalProperties": false,
      "properties": {
        "inFlight": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "loadAvg1": {
          "minimum": 0,
          "type": "number"
        },
        "memoryAvailableBytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "loadAvg1",
        "memoryAvailableBytes",
        "inFlight"
      ],
      "type": "object"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "reportedAt": {
      "minimum": 0,
      "type": "number"
    },
    "screen": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "detail": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "screen_recording_denied",
                  "accessibility_denied",
                  "no_console_user",
                  "other_console_user",
                  "display_asleep",
                  "no_x_display",
                  "x_auth_refused",
                  "x_display_forwarded",
                  "wayland_only_no_x",
                  "missing_x_libs",
                  "no_atspi_bus",
                  "observer_unavailable",
                  "session_zero",
                  "window_manager_missing",
                  "input_monitoring_not_granted",
                  "no_screen_backend",
                  "input_backend_unavailable",
                  "accessibility_unavailable"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "display": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "isolated": {
              "type": "boolean"
            },
            "kind": {
              "enum": [
                "console",
                "virtual",
                "none"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "isolated"
          ],
          "type": "object"
        },
        "grants": {
          "additionalProperties": false,
          "properties": {
            "accessibility": {
              "type": "boolean"
            },
            "capture": {
              "type": "boolean"
            },
            "input": {
              "type": "boolean"
            }
          },
          "required": [
            "capture",
            "accessibility",
            "input"
          ],
          "type": "object"
        },
        "verdict": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ],
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "blockers",
        "display",
        "grants"
      ],
      "type": "object"
    },
    "session": {
      "additionalProperties": false,
      "properties": {
        "asleep": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      },
      "required": [
        "locked",
        "asleep"
      ],
      "type": "object"
    },
    "streams": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytesPerSecond": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "droppedFrames": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "encodeMs": {
            "maximum": 60000,
            "minimum": 0,
            "type": "number"
          },
          "fps": {
            "maximum": 60,
            "minimum": 0,
            "type": "number"
          },
          "private": {
            "type": "boolean"
          },
          "retainedBytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "streamId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "streamId",
          "private",
          "fps",
          "bytesPerSecond",
          "encodeMs",
          "droppedFrames",
          "retainedBytes"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "type": "array"
    },
    "transport": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "lastFailure": {
          "anyOf": [
            {
              "enum": [
                "authentication",
                "configuration",
                "host_unreachable",
                "remote_unavailable",
                "timeout",
                "superseded"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lastFailure",
        "attempts"
      ],
      "type": "object"
    }
  },
  "required": [
    "machineId",
    "reportedAt",
    "load"
  ],
  "type": "object"
}
