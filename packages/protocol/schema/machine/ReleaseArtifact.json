{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "bytes": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "url": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "name",
    "bytes",
    "sha256",
    "url"
  ],
  "type": "object"
}
