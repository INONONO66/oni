{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "seq": {
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "signal": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "sdp": {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "offer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sdp"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "sdp": {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "answer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sdp"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "candidate": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "sdpMLineIndex": {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "sdpMid": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "candidate",
              "type": "string"
            }
          },
          "required": [
            "type",
            "candidate"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "end_of_candidates",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "maxLength": 21844,
              "minLength": 1,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "type": "string"
            },
            "label": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "data",
              "type": "string"
            }
          },
          "required": [
            "type",
            "label",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "streamId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "streamId",
    "seq",
    "signal"
  ],
  "type": "object"
}
