{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "at": {
      "minimum": 0,
      "type": "number"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "enum": [
        "pointer",
        "keyboard",
        "clipboard"
      ],
      "type": "string"
    },
    "time": {
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "machineId",
    "at",
    "source",
    "time"
  ],
  "type": "object"
}
