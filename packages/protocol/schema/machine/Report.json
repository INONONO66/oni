{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "humanInput": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "lastAt": {
          "minimum": 0,
          "type": "number"
        },
        "source": {
          "enum": [
            "pointer",
            "keyboard",
            "both"
          ],
          "type": "string"
        }
      },
      "required": [
        "lastAt",
        "source",
        "events"
      ],
      "type": "object"
    },
    "humanInputUnavailable": {
      "enum": [
        "input_monitoring_not_granted"
      ],
      "type": "string"
    },
    "load": {
      "additionalProperties": false,
      "properties": {
        "inFlight": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "loadAvg1": {
          "minimum": 0,
          "type": "number"
        },
        "memoryAvailableBytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "loadAvg1",
        "memoryAvailableBytes",
        "inFlight"
      ],
      "type": "object"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "reportedAt": {
      "minimum": 0,
      "type": "number"
    },
    "screen": {
      "additionalProperties": false,
      "properties": {
        "permission": {
          "enum": [
            "granted",
            "denied",
            "unsupported"
          ],
          "type": "string"
        }
      },
      "required": [
        "permission"
      ],
      "type": "object"
    },
    "session": {
      "additionalProperties": false,
      "properties": {
        "asleep": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        }
      },
      "required": [
        "locked",
        "asleep"
      ],
      "type": "object"
    },
    "streams": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytesPerSecond": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "droppedFrames": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "encodeMs": {
            "maximum": 60000,
            "minimum": 0,
            "type": "number"
          },
          "fps": {
            "maximum": 60,
            "minimum": 0,
            "type": "number"
          },
          "private": {
            "type": "boolean"
          },
          "retainedBytes": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "streamId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "streamId",
          "private",
          "fps",
          "bytesPerSecond",
          "encodeMs",
          "droppedFrames",
          "retainedBytes"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "type": "array"
    },
    "transport": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "lastFailure": {
          "anyOf": [
            {
              "enum": [
                "authentication",
                "configuration",
                "host_unreachable",
                "remote_unavailable",
                "timeout",
                "superseded"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lastFailure",
        "attempts"
      ],
      "type": "object"
    }
  },
  "required": [
    "machineId",
    "reportedAt",
    "load"
  ],
  "type": "object"
}
