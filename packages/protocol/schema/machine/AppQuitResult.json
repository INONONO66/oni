{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "exited": {
          "type": "boolean"
        },
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status",
        "exited"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "blocker": {
          "enum": [
            "launch_timeout",
            "launch_failed",
            "platform"
          ],
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "app_not_found",
            "launch_failed",
            "excluded",
            "permission_denied",
            "machine_not_attached",
            "unsupported",
            "process_not_found",
            "epoch_changed",
            "window_not_found"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
