{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        },
        "status": {
          "const": "ok",
          "type": "string"
        },
        "windows": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "epoch": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "pid": {
                "maximum": 9007199254740991,
                "minimum": 1,
                "type": "integer"
              },
              "windowId": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "pid",
              "windowId",
              "epoch"
            ],
            "type": "object"
          },
          "maxItems": 512,
          "type": "array"
        }
      },
      "required": [
        "status",
        "pid",
        "windows"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "blocker": {
          "enum": [
            "launch_timeout",
            "launch_failed",
            "platform"
          ],
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "app_not_found",
            "launch_failed",
            "excluded",
            "permission_denied",
            "machine_not_attached",
            "unsupported",
            "process_not_found",
            "epoch_changed",
            "window_not_found"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
