{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cli": {
                "enum": [
                  "claude-code",
                  "codex",
                  "pi",
                  "omp"
                ],
                "type": "string"
              },
              "project": {
                "maxLength": 4096,
                "minLength": 1,
                "pattern": "^\\/(?!\\.\\.(?:\\/|$)|.*\\/\\.\\.(?:\\/|$))[^\\x00]*$",
                "type": "string"
              },
              "sessionId": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "state": {
                "enum": [
                  "running",
                  "stopped"
                ],
                "type": "string"
              }
            },
            "required": [
              "sessionId",
              "project",
              "cli",
              "state"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array"
        },
        "status": {
          "const": "ok",
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "sessions",
        "truncated"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "machine_not_attached",
            "session_not_available",
            "session_not_found",
            "invalid_cursor",
            "permission_denied",
            "permission_timeout"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
