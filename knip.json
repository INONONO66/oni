{
  "$schema": "https://unpkg.com/knip/schema.json",
  "ignoreBinaries": ["mkfifo"],
  "ignore": ["**/*.bench.ts"],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "script/**/*.{ts,mjs}",
        "biome.json",
        "lefthook.yml",
        "commitlint.config.*"
      ],
      "project": [
        "script/**/*.{ts,mjs}",
        "*.json",
        "*.jsonc",
        "*.yml",
        "*.yaml"
      ]
    },
    "apps/desktop": {
      "entry": [
        "test/**/*.test.ts",
        "test-e2e/**/*.spec.ts",
        "test/helpers/unbound-store.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts", "test-e2e/**/*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/openomni": {
      "entry": [
        "test/**/*.test.ts",
        "test/fixtures/*.ts",
        "test/helpers/generation-crash-process.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/agent": {
      "entry": ["test/**/*.test.ts", "test/helpers/cluster-crash-child.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/channels": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/llm": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/codemode": {
      "entry": [
        "test/**/*.test.ts",
        "test/codemode/helpers/close-race-normal-answer.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/machines": {
      "entry": ["test/**/*.test.ts", "test/helpers/fifo-request.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignore": ["test/ipc/typed-facade-fixtures/**"]
    },
    "packages/protocol": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  }
}
