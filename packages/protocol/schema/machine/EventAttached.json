{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "effectiveCapabilities": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "type": "string"
      },
      "type": "array"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "time": {
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "machineId",
    "time",
    "effectiveCapabilities"
  ],
  "type": "object"
}
