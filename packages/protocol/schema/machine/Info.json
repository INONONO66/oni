{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "allowedCapabilities": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "allowedExports": {
      "items": {
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      },
      "type": "array"
    },
    "arch": {
      "type": "string"
    },
    "capabilities": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "type": "string"
      },
      "type": "array"
    },
    "enrolledAt": {
      "minimum": 0,
      "type": "number"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "live": {
      "additionalProperties": false,
      "properties": {
        "humanInput": {
          "additionalProperties": false,
          "properties": {
            "events": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "lastAt": {
              "minimum": 0,
              "type": "number"
            },
            "source": {
              "enum": [
                "pointer",
                "keyboard",
                "both"
              ],
              "type": "string"
            }
          },
          "required": [
            "lastAt",
            "source",
            "events"
          ],
          "type": "object"
        },
        "load": {
          "additionalProperties": false,
          "properties": {
            "inFlight": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "loadAvg1": {
              "minimum": 0,
              "type": "number"
            },
            "memoryAvailableBytes": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "loadAvg1",
            "memoryAvailableBytes",
            "inFlight"
          ],
          "type": "object"
        },
        "reportedAt": {
          "minimum": 0,
          "type": "number"
        },
        "screen": {
          "additionalProperties": false,
          "properties": {
            "blockers": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "detail": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "screen_recording_denied",
                      "accessibility_denied",
                      "no_console_user",
                      "other_console_user",
                      "display_asleep",
                      "no_x_display",
                      "x_auth_refused",
                      "x_display_forwarded",
                      "wayland_only_no_x",
                      "missing_x_libs",
                      "no_atspi_bus",
                      "observer_unavailable",
                      "session_zero",
                      "window_manager_missing",
                      "input_monitoring_not_granted",
                      "no_screen_backend",
                      "input_backend_unavailable"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "display": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "isolated": {
                  "type": "boolean"
                },
                "kind": {
                  "enum": [
                    "console",
                    "virtual",
                    "none"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "isolated"
              ],
              "type": "object"
            },
            "grants": {
              "additionalProperties": false,
              "properties": {
                "accessibility": {
                  "type": "boolean"
                },
                "capture": {
                  "type": "boolean"
                },
                "input": {
                  "type": "boolean"
                }
              },
              "required": [
                "capture",
                "accessibility",
                "input"
              ],
              "type": "object"
            },
            "verdict": {
              "enum": [
                "available",
                "partial",
                "unavailable"
              ],
              "type": "string"
            }
          },
          "required": [
            "verdict",
            "blockers",
            "display",
            "grants"
          ],
          "type": "object"
        },
        "session": {
          "additionalProperties": false,
          "properties": {
            "asleep": {
              "type": "boolean"
            },
            "locked": {
              "type": "boolean"
            }
          },
          "required": [
            "locked",
            "asleep"
          ],
          "type": "object"
        },
        "stale": {
          "type": "boolean"
        },
        "transport": {
          "additionalProperties": false,
          "properties": {
            "attempts": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "lastFailure": {
              "anyOf": [
                {
                  "enum": [
                    "authentication",
                    "configuration",
                    "host_unreachable",
                    "remote_unavailable",
                    "timeout",
                    "superseded"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "lastFailure",
            "attempts"
          ],
          "type": "object"
        }
      },
      "required": [
        "reportedAt",
        "load",
        "stale"
      ],
      "type": "object"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "peer": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "daemon",
            "client"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "contractVersion"
      ],
      "type": "object"
    },
    "pendingCapabilities": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "type": "string"
      },
      "type": "array"
    },
    "publicKey": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "resources": {
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "memoryBytes": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "cpus",
        "memoryBytes"
      ],
      "type": "object"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "machineId",
    "name",
    "tags",
    "allowedCapabilities",
    "publicKey",
    "enrolledAt",
    "capabilities",
    "pendingCapabilities",
    "os",
    "arch"
  ],
  "type": "object"
}
