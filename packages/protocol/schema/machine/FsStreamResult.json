{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "begun",
          "type": "string"
        }
      },
      "required": [
        "status",
        "seq",
        "size"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "maxLength": 349528,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "last": {
          "type": "boolean"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "chunk",
          "type": "string"
        }
      },
      "required": [
        "status",
        "seq",
        "data",
        "last"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "bytesWritten": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "last": {
          "type": "boolean"
        },
        "seq": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "written",
          "type": "string"
        }
      },
      "required": [
        "status",
        "seq",
        "bytesWritten",
        "last"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "finished",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "export_not_available",
            "path_escapes_export",
            "not_found",
            "already_exists",
            "wrong_kind",
            "io_error",
            "too_large",
            "fs_not_available",
            "machine_not_attached",
            "ambiguous_export",
            "transfer_not_found",
            "invalid_sequence",
            "digest_mismatch"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "message"
      ],
      "type": "object"
    }
  ]
}
