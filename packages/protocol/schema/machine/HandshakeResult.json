{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "ephemeralKey": {
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "type": "string"
        },
        "signature": {
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "type": "string"
        },
        "staticKey": {
          "maxLength": 1024,
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "status": {
          "const": "accepted",
          "type": "string"
        }
      },
      "required": [
        "status",
        "staticKey",
        "ephemeralKey",
        "nonce",
        "signature"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "not_admitted",
            "replay",
            "unsupported_contract"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
