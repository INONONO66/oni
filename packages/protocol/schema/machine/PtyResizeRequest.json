{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "cols": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "integer"
    },
    "name": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "rows": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "integer"
    }
  },
  "required": [
    "name",
    "cols",
    "rows"
  ],
  "type": "object"
}
