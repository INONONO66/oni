{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "press",
        "down",
        "up"
      ],
      "type": "string"
    },
    "captureId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "key": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "modifiers": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "type": "boolean"
        },
        "control": {
          "type": "boolean"
        },
        "meta": {
          "type": "boolean"
        },
        "shift": {
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "captureId",
    "key",
    "action"
  ],
  "type": "object"
}
