{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sessionId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "additionalProperties": false,
          "properties": {
            "byteOffset": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "generation": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "recordHash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "sessionId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "sessionId",
            "generation",
            "byteOffset",
            "recordHash"
          ],
          "type": "object"
        }
      },
      "required": [
        "cursor"
      ],
      "type": "object"
    }
  ]
}
