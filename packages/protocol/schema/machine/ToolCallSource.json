{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "session",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "machine",
          "type": "string"
        },
        "machineId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "machineId"
      ],
      "type": "object"
    }
  ]
}
