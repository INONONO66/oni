{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "permission_denied",
            "lease_missing",
            "lease_expired",
            "target_unbound",
            "app_out_of_scope",
            "foreground_not_granted",
            "excluded",
            "stale_capture",
            "stale_observation",
            "paused:takeover",
            "paused:private",
            "paused:locked",
            "paused:asleep"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "humanActiveMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "const": "paused:human_input",
          "type": "string"
        },
        "retryAfterMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "humanActiveMs",
        "retryAfterMs"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "const": "budget_exhausted",
          "type": "string"
        },
        "resetAt": {
          "minimum": 0,
          "type": "number"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "resetAt"
      ],
      "type": "object"
    }
  ]
}
