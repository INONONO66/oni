{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "parked": {
          "type": "boolean"
        },
        "status": {
          "const": "ok",
          "type": "string"
        }
      },
      "required": [
        "status",
        "parked"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "blocker": {
          "enum": [
            "launch_timeout",
            "launch_failed",
            "platform"
          ],
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "app_not_found",
            "launch_failed",
            "excluded",
            "permission_denied",
            "machine_not_attached",
            "unsupported",
            "process_not_found",
            "epoch_changed",
            "window_not_found",
            "lease_missing",
            "lease_expired",
            "target_unbound",
            "app_out_of_scope",
            "foreground_not_granted",
            "paused:human_input",
            "paused:takeover",
            "paused:private",
            "paused:locked",
            "paused:asleep"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "dispatched": {
          "const": "unknown",
          "type": "string"
        },
        "hint": {
          "const": "re_observe",
          "type": "string"
        },
        "reason": {
          "const": "cancelled",
          "type": "string"
        },
        "status": {
          "const": "unverifiable",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "dispatched",
        "hint"
      ],
      "type": "object"
    }
  ]
}
