{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "leaseId": {
      "minLength": 1,
      "type": "string"
    },
    "machineId": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "enum": [
        "expired",
        "revoked"
      ],
      "type": "string"
    },
    "time": {
      "minimum": 0,
      "type": "number"
    },
    "to": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "machineId",
    "time",
    "leaseId",
    "to",
    "reason"
  ],
  "type": "object"
}
