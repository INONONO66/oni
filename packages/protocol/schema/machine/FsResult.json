{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "completed",
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "bytesWritten": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "op": {
                  "const": "write",
                  "type": "string"
                }
              },
              "required": [
                "op",
                "bytesWritten"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "bytesRead": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "data": {
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "type": "string"
                },
                "op": {
                  "const": "read",
                  "type": "string"
                },
                "size": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "op",
                "data",
                "bytesRead",
                "size",
                "truncated"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "entries": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "file",
                          "dir",
                          "symlink",
                          "other"
                        ],
                        "type": "string"
                      },
                      "name": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "size": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "name",
                      "kind"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "op": {
                  "const": "list",
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "op",
                "entries",
                "truncated"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "file",
                    "dir",
                    "symlink",
                    "other"
                  ],
                  "type": "string"
                },
                "mtimeMs": {
                  "type": "number"
                },
                "op": {
                  "const": "stat",
                  "type": "string"
                },
                "size": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "op",
                "kind",
                "size",
                "mtimeMs"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "status",
        "value"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "export_not_available",
            "path_escapes_export",
            "not_found",
            "wrong_kind",
            "io_error",
            "too_large",
            "ambiguous_export",
            "machine_not_attached",
            "fs_not_available"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "message"
      ],
      "type": "object"
    }
  ]
}
