{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "channelId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "data": {
      "maxLength": 349524,
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "channelId",
    "seq",
    "data"
  ],
  "type": "object"
}
