{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "landedOn": {
          "additionalProperties": false,
          "properties": {
            "app": {
              "minLength": 1,
              "type": "string"
            },
            "pid": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "pid"
          ],
          "type": "object"
        },
        "status": {
          "const": "ok",
          "type": "string"
        },
        "target": {
          "additionalProperties": false,
          "properties": {
            "pid": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "source": {
              "enum": [
                "window_capture",
                "display_hit_test"
              ],
              "type": "string"
            },
            "windowId": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "pid",
            "windowId",
            "source"
          ],
          "type": "object"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "dispatched": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ]
        },
        "hint": {
          "const": "re_observe",
          "type": "string"
        },
        "reason": {
          "enum": [
            "transport_lost",
            "cancelled",
            "detached",
            "driver_timeout"
          ],
          "type": "string"
        },
        "status": {
          "const": "unverifiable",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "dispatched",
        "hint"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "humanActiveMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "machine_not_attached",
            "input_not_available",
            "stale_capture",
            "invalid_region",
            "permission_denied",
            "unsupported_action",
            "input_failed",
            "spawn_failed",
            "probe_timeout",
            "epoch_changed",
            "stale_observation",
            "ref_not_found",
            "action_not_supported",
            "not_actionable",
            "window_not_found",
            "observe_not_available",
            "foreground_required",
            "window_busy",
            "request_busy",
            "private",
            "accessibility_unavailable",
            "lease_missing",
            "lease_expired",
            "target_unbound",
            "app_out_of_scope",
            "foreground_not_granted",
            "excluded",
            "paused:human_input",
            "paused:takeover",
            "paused:private",
            "paused:locked",
            "paused:asleep",
            "budget_exhausted"
          ],
          "type": "string"
        },
        "resetAt": {
          "minimum": 0,
          "type": "number"
        },
        "retryAfterMs": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "landedOn": {
          "additionalProperties": false,
          "properties": {
            "app": {
              "minLength": 1,
              "type": "string"
            },
            "pid": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "pid"
          ],
          "type": "object"
        },
        "reason": {
          "const": "target_mismatch",
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "landedOn"
      ],
      "type": "object"
    }
  ]
}
