{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "status": {
      "enum": [
        "live",
        "lost"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "status"
  ],
  "type": "object"
}
