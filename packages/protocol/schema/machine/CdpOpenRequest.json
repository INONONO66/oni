{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "channelId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "endpoint": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "discover",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "launch",
              "type": "string"
            },
            "manifest": {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "manifest"
          ],
          "type": "object"
        }
      ]
    },
    "lifetimeMs": {
      "exclusiveMinimum": 0,
      "maximum": 3600000,
      "type": "integer"
    }
  },
  "required": [
    "channelId",
    "endpoint",
    "lifetimeMs"
  ],
  "type": "object"
}
