{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "accessibilityUnavailable": {
          "type": "boolean"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "maximum": 4194304,
          "type": "integer"
        },
        "captureId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "capturedAtUs": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "display": {
          "exclusiveMinimum": 0,
          "maximum": 16,
          "type": "integer"
        },
        "format": {
          "enum": [
            "png",
            "jpeg"
          ],
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "type": "integer"
        },
        "scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 8,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 16384,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "captureId",
        "display",
        "width",
        "height",
        "scale",
        "format",
        "bytes",
        "sha256",
        "capturedAtUs"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "enum": [
            "machine_not_attached",
            "screen_not_available",
            "invalid_region",
            "permission_denied",
            "capture_failed",
            "spawn_failed",
            "read_failed",
            "probe_timeout",
            "display_not_found",
            "window_not_found",
            "window_minimized",
            "capture_blank",
            "own_window",
            "superseded",
            "accessibility_unavailable",
            "private"
          ],
          "type": "string"
        },
        "status": {
          "const": "refused",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    }
  ]
}
