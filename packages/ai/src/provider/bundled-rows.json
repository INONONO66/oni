{
  "providers": [
    {
      "id": "anthropic",
      "npm": "@ai-sdk/anthropic",
      "headers": {
        "anthropic-beta": "interleaved-thinking-2025-05-14,fine-grained-tool-streaming-2025-05-14"
      }
    },
    {
      "id": "openai",
      "npm": "@ai-sdk/openai",
      "api": "responses",
      "transcription": "gpt-4o-transcribe",
