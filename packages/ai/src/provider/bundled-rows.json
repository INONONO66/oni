        "model": "gpt-realtime-2.1",
        "endpoint": "wss://api.openai.com/v1/realtime",
        "voice": "marin"
      },
      "speech": {
        "model": "gpt-4o-mini-tts",
        "voice": "alloy",
        "format": "mp3"
      },
      "image": {
        "model": "gpt-image-1"
      }
    },
    {
      "id": "google",
      "npm": "@ai-sdk/google",
      "transcription": "gemini-3.5-transcribe",
      "speech": {
        "model": "gemini-2.5-flash-preview-tts",
        "voice": "Kore",
        "format": "wav"
      },
      "image": {
        "model": "gemini-2.5-flash-image"
      }
    }
  ]
