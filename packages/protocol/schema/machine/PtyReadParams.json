{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "source": {
          "const": "screen",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "waitMs": {
          "maximum": 30000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  ]
}
