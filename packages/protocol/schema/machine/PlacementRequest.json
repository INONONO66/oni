{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "prefer": {
      "anyOf": [
        {
          "enum": [
            "spread",
            "pack",
            "exclusive",
            "computer"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "computer",
              "type": "string"
            },
            "sticky": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "sticky"
          ],
          "type": "object"
        }
      ]
    },
    "requires": {
      "items": {
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
        "type": "string"
      },
      "type": "array"
    },
    "tag": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "tag",
    "prefer"
  ],
  "type": "object"
}
