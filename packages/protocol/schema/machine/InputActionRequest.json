{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "press",
        "setValue",
        "perform"
      ],
      "type": "string"
    },
    "name": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "observationId": {
      "maxLength": 32,
      "pattern": "^o\\d+$",
      "type": "string"
    },
    "ref": {
      "maxLength": 256,
      "pattern": "^[^/[\\]]*\\[\\d+\\](?:\\/[^/[\\]]*\\[\\d+\\])*$",
      "type": "string"
    },
    "requestId": {
      "pattern": "^[1-9]\\d*-[1-9]\\d*$",
      "type": "string"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "pid": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "windowId": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pid",
        "windowId",
        "epoch"
      ],
      "type": "object"
    },
    "value": {
      "maxLength": 65536,
      "type": "string"
    },
    "waitMs": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "requestId",
    "observationId",
    "target",
    "ref",
    "action"
  ],
  "type": "object"
}
