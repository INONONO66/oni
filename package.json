{
  "name": "oni",
  "version": "0.1.0",
  "description": "Single-Owner Agent OS — one Resident, isolated Workers, one ledger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INONONO66/oni.git"
  },
  "scripts": {
    "build": "turbo run build",
    "ci": "bun run script/ci.ts",
    "ci:plan": "bun run script/ci-plan.ts",
    "ci:test": "bun run script/ci.ts test",
    "ci:check-types": "bun run script/ci.ts check-types",
    "check-effect-boundaries": "bun run script/check-effect-boundaries.ts",
    "check-journal-writers": "bun run script/check-journal-writers.ts",
    "check-written-types": "bun run script/check-written-types.ts",
    "clients:build": "cd clients && cargo build --release",
    "clients:lint": "cd clients && cargo fmt --all --check && cargo clippy --all-targets -- -D warnings -D clippy::unwrap_used",
    "clients:test": "cd clients && cargo test",
    "clients:conformance": "cd script && bun test ./check-clients-conformance.test.ts --timeout 15000 --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "dev": "turbo run dev",
    "prepare": "lefthook install",
    "lint": "bun run lint:guards && bun run lint:side-effects && bun run lint:docs && bunx ultracite check --formatter-enabled=false .",
    "lint:docs": "bun run script/generate-agents-deps.ts --check",
    "lint:guards": "bun run script/lint-guards.ts",
    "lint:side-effects": "bun run script/lint-side-effects.ts",
    "lint:tools": "bun run script/lint-tools.ts",
    "lint:fix": "bunx ultracite fix .",
    "format": "bunx biome format --write .",
    "check-types": "turbo run check-types && tsc -p script/tsconfig.json",
    "test": "turbo run test",
    "bench": "turbo run bench",
    "quality:clones:production": "jscpd --config script/quality-audit-jscpd-production.json",
    "quality:clones:test": "jscpd --config script/quality-audit-jscpd-test.json",
    "generate:agents-deps": "bun run script/generate-agents-deps.ts",
    "generate:machine-schema": "bun run script/generate-machine-schema.ts",
    "generate:models-snapshot": "bun run script/generate-models-snapshot.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "1.3.12",
    "effect": "4.0.0-rc.118",
    "jscpd": "5.3.0",
    "knip": "6.31.0",
    "lefthook": "^2.1.4",
    "tinybench": "^6.0.2",
    "turbo": "^2.8.1",
    "typescript": "5.9.2",
    "ultracite": "7.8.3",
    "zod": "^4.5.4"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.1",
  "trustedDependencies": [
    "electron"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "patchedDependencies": {
    "typescript@5.9.2": "patches/typescript@5.9.2.patch"
  }
}
