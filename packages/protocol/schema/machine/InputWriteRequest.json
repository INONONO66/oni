{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "click": {
                "additionalProperties": false,
                "properties": {
                  "button": {
                    "enum": [
                      "left",
                      "right",
                      "middle"
                    ],
                    "type": "string"
                  },
                  "x": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "y": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "type": "object"
              }
            },
            "required": [
              "click"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "maxLength": 10000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "key": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              }
            },
            "required": [
              "key"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "move": {
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "y": {
                    "maximum": 9007199254740991,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "type": "object"
              }
            },
            "required": [
              "move"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "scroll": {
                "additionalProperties": false,
                "properties": {
                  "deltaX": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  "deltaY": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "scroll"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "captureId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "captureId",
    "actions"
  ],
  "type": "object"
}
